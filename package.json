{
  "name": "fnb-stadium-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Vendor, kiosk, storage and load-out operations for FNB Stadium",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "npm run db:seed --silent && next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "tsx scripts/reset.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.44.2",
    "next": "^16.2.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
